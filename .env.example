# Server Configuration
PORT=8000
HOST=127.0.0.1
DEBUG=True

# Database Configuration
DATABASE_URL=sqlite:///./modelforge.db

# Storage Directories
DATA_DIR=./exports/data
MODELS_DIR=./exports/models

# Optional AI Assistant Provider (Default is deterministic offline fallback)
# Supported: offline, openai, gemini
AI_PROVIDER=offline
OPENAI_API_KEY=
GEMINI_API_KEY=
